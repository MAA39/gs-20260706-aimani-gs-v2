    "@gs-v2/shared": "workspace:*",
    "agents": "^0.16.2",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260601.0",
    "@flue/cli": "1.0.0-beta.1",
    "typescript": "^5.8.0",
    "wrangler": "^4.0.0"
  }
